
; --- MBMM SYSTEM ARCHITECTURE: FULL_DIMM ---
; Base Model: reram_22nm_1t1r_slc | Rank Width: 64-bit

; --- Infrastructure ---
IgnorePremappedAddresses true
IgnoreAddressError true
AddressMask 0xFFFFFFFF
PrintConfig true
PrintAllDevices true
EnableDebug false
MAP_ADDRESS true
DECODER MigratingDecoder
INTERCONNECT OffChipBus
STATS_OUT nvmain_stats_reram_22nm_1t1r_slc_full_dimm.out
CPUFreq 800

; --- Clock, Controller and Scaling ---
CLK 800
MEM_CTL FRFCFS
DEVICES_PER_RANK 8

; --- Address Mapping ---
AddressMappingScheme R:BK:RK:C
BusWidth 64
DeviceWidth 8
RATE 2

; --- Timing Parameters (Cycles) ---
tCAS 26
tRCD 26
tRP 1       
tRAS 26
tWR 26
tRTW 26
tBus 4
tCMD 1

; --- Energy and Power ---
ReadEnergy 1.1910
WriteEnergy 1.738
StandbyPower 50.857984

; --- Geometry Scaling ---
ROWS 131072
COLS 1024
CHANNELS 1
RANKS 8
BANKS 8
SUBARRAYS 1

; --- NVM Specific Logic ---
ClosePage 1
UseRefresh false
UsePrecharge true
EnergyModel NonVolatile
