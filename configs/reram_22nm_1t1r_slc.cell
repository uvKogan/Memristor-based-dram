# Physical bit-cell definition for 1T1R architecture

-MemCellType: ReRAM           # Defines the material class as Resistive RAM

-ProcessNode: 22              # Targets the 22nm node (Intel/TSMC standard)

#-CellArea (F^2): 100.0        # Commercial 22nm 1T1R area (~0.048 um^2)
-CellArea (F^2): 20.0        # Commercial 22nm 1T1R area (~0.048 um^2)
-CellAspectRatio: 1.0         # Balanced bit-cell layout

-ResistanceOn (ohm): 100000   # LRS: 10^5 ohm to mitigate IR-drop
-ResistanceOff (ohm): 1000000000 # HRS: 10^9 ohm for high signal margin

-ReadLatency: 5
-SetLatency: 10
-ResetLatency: 10
-ReadEnergy: 0.1
-SetEnergy: 1.0
-ResetEnergy: 1.0

-ReadMode: current            # Sensing current vs a reference
-ReadVoltage (V): 0.4         # Voltage applied to the bit-line during read

-ResetMode: voltage           # RESET triggered by voltage polarity
-ResetVoltage (V): 2.0        # Voltage required to rupture the filament
-ResetPulse (ns): 5           # State-of-the-art 5ns timing

-SetMode: voltage             # SET triggered by voltage polarity
-SetVoltage (V): 1.0          # Voltage required to form the filament
-SetPulse (ns): 5             # Fast 5ns SET time

-AccessType: CMOS             # Identifies this as a 1-Transistor 1-Resistor cell